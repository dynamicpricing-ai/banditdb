# BanditDB customer instance — nginx vhost template.
# Rendered by firstboot.sh with __SERVER_NAME__ substituted.
#
# Deliberately different from scripts/nginx_sandbox.conf: the sandbox limits to
# 10 req/s PER IP because it faces the public and every visitor is a different
# address. A customer instance is the opposite — all traffic arrives from one or
# two backend IPs, so a per-IP limit would cap the customer at 10 req/s no matter
# what they are paying for.
#
# Rate limiting here is a blunt safety net set far above any legitimate load
# (the server itself does ~10,000 predictions/s). Real per-key limiting is the
# database's job via BANDITDB_RATE_LIMIT_PER_SEC.

limit_req_zone $binary_remote_addr zone=safety:10m rate=2000r/s;

server {
    listen 80;
    listen [::]:80;
    server_name __SERVER_NAME__;

    # certbot writes its challenge here; everything else redirects to HTTPS
    # once a certificate exists. Until then the API is reachable over plain
    # HTTP so that provisioning can be verified before DNS/TLS is finished.
    location /.well-known/acme-challenge/ {
        root /var/www/html;
    }

    location / {
        limit_req zone=safety burst=4000 nodelay;
        limit_req_status 429;

        proxy_pass         http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;

        # A reward blocks on an fsync before it answers. The nginx default of
        # 60s is ample, but a contended disk plus a large checkpoint can be
        # slow, and a truncated reward looks to the caller like data loss.
        proxy_read_timeout    120s;
        proxy_send_timeout    120s;
        proxy_connect_timeout 5s;

        # batch_predict accepts up to 100 contexts; large embedding vectors add up.
        client_max_body_size 8m;
    }

    # Unrestricted: load balancer probes and uptime monitors must never be
    # rate limited, and this route exposes no campaign data.
    location = /health {
        proxy_pass http://127.0.0.1:8080;
        access_log off;
    }

    # /metrics names campaigns and arms. The database requires a reader key for
    # it unless BANDITDB_METRICS_PUBLIC is set, so this is closed by default.
    # Restrict by source as well if your Prometheus has a stable address:
    #   allow 203.0.113.10; deny all;
    location = /metrics {
        proxy_pass http://127.0.0.1:8080;
        access_log off;
    }
}
